name = "xiguaAp6y3/moonbit-casbin"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/xiguaAp6y3/moonbit-casbin"

license = "Apache-2.0"

description = "Casbin-style authorization engine in MoonBit: model-driven policy configuration, matcher and effect evaluation, RBAC role hierarchy, and an in-memory policy store."

keywords = [
  "casbin",
  "authorization",
  "access-control",
  "rbac",
  "abac",
  "policy",
  "security",
  "moonbit",
]

import {
  "moonbitlang/regexp@0.3.5",
}
